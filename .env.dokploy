# Environment Variables for Dokploy Deployment
# Copy these variables to Dokploy UI → Application → Environment

# Database Configuration (PostgreSQL)
POSTGRES_DB=wordwaverise
POSTGRES_USER=wordwaverise_user
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD_HERE

# JWT Configuration
# Generate strong secret: openssl rand -base64 32
JWT_SECRET=CHANGE_ME_256_BIT_RANDOM_STRING_HERE
JWT_ISSUER=wordwaverise-backend
JWT_AUDIENCE=wordwaverise-app
JWT_REALM=Access to WordWaverise API
JWT_EXPIRATION_HOURS=720

# Application Environment
APP_ENV=production

# Resend (transactional email — verification codes, deletion notices)
RESEND_API_KEY=re_CHANGE_ME
RESEND_FROM_EMAIL=noreply@wordwaverise.com

# Delayed account deletion grace period (days)
ACCOUNT_DELETION_GRACE_DAYS=30

# AI provider (OpenAI-compatible chat-completions API)
# AI_DOMEN and AI_API were already required; the rest were simply missing from docker-compose,
# so production silently ran the code default instead of any model set here.
AI_DOMEN=
AI_API=

# Model quality is the single biggest lever on Russian translation quality.
# Leave empty to keep the current llama-3.3-70b-versatile, or set the exact name your
# provider serves for a stronger model. Check the "AI config:" line in the boot log to
# confirm what actually took effect.
AI_MODEL=
# Cheaper model for auxiliary tasks (query resolution). Empty = same as AI_MODEL.
AI_MODEL_FAST=

# Request-body dialect. Defaults match llama; gpt-5.x needs max_completion_tokens and
# rejects temperature. Both are auto-corrected at runtime on the first 400, so setting
# AI_MODEL alone is safe — these only save one round-trip.
AI_TOKEN_PARAM=max_tokens
AI_SUPPORTS_TEMPERATURE=true

AI_TIMEOUT_MS=150000
AI_MAX_RETRIES=2

# Reserve provider — its own quota, same model. Carries the corpus warm-up so a bulk run
# cannot spend the budget real lookups need, and catches user requests when the primary is
# rate limited. Leave blank to disable both behaviours.
AI_DOMEN_POOL=
AI_API_POOL=
AI_MODEL_POOL=claude-sonnet-4-6

# Corpus warm-up. Paced far below the scraper rate limit so it never queues ahead of a real
# lookup; 30/hour means the 2000-word B2/C1 band takes about three days.
WARMUP_ENABLED=false
WARMUP_WORDS_PER_HOUR=30
# 0 = the whole list
WARMUP_LIMIT=0

# Google OAuth (Web application client ID — see setup steps discussed separately)
GOOGLE_CLIENT_ID=

# Admin panel access (sent as X-Admin-Secret header by the web app's /admin page)
# Generate strong secret: openssl rand -base64 32
ADMIN_SECRET=CHANGE_ME_STRONG_RANDOM_STRING_HERE

# Origin the crawlable pages (/word/..., /words, /sitemap.xml) present as their own.
# These are served to users through the site's nginx, so canonicals must name the site,
# never backend.wordwaverise.com. Defaults to https://wordwaverise.com.
SITE_URL=https://wordwaverise.com

# ── Web Push (напоминания о повторении) ────────────────────────────────────
# Пара VAPID-ключей. Сгенерировать один раз:  npx web-push generate-vapid-keys
# Смена ключей обесценивает все существующие подписки — push-сервис привязывает
# выданный endpoint к ключу, который его запросил. Пустые ключи полностью
# выключают фичу: подписки не принимаются и не хранятся.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Контакт для push-сервиса, mailto: или https://
VAPID_SUBJECT=mailto:support@wordwaverise.com
# Рубильник ежедневной рассылки. Подписка работает независимо от него.
PUSH_REMINDERS_ENABLED=false
# Час UTC, когда уходит напоминание. 15 UTC = 18:00 МСК.
PUSH_REMINDER_HOUR_UTC=15

# Database Connection (Auto-configured by docker-compose)
DB_URL=jdbc:postgresql://db:5432/${POSTGRES_DB}
DB_USER=${POSTGRES_USER}
DB_PASSWORD=${POSTGRES_PASSWORD}
DB_DRIVER=org.postgresql.Driver

# Image tag pulled from GHCR (see DEPLOY.md)
# Leave unset for the latest master build; set to sha-<commit> to pin/rollback.
# IMAGE_TAG=latest
